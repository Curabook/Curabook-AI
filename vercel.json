{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/app", "dest": "/frontend/app.html" },
    { "src": "/login", "dest": "/frontend/login.html" },
    { "src": "/signup", "dest": "/frontend/signup.html" },
    { "src": "/demo", "dest": "/frontend/demo.html" },
    { "src": "/privacy", "dest": "/frontend/privacy.html" },
    { "src": "/terms", "dest": "/frontend/terms.html" },
    { "src": "/(.*\\.(css|js|png|jpg|jpeg|svg|ico|pdf|txt|webmanifest))", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/app.py" }
  ]
}